<!--
  Authored to match the lucide geometry the wireframe specifies (SCR-14 / camera TopBar / AddSheet
  name it by lucide id). The supplied `icon_936` folder covers only A4, payment card and trash, so
  these were drawn from the lucide 24x24 stroke grid rather than left as text glyphs — a `‹` or `⌄`
  character puts far less ink inside its button than a 22dp icon does, which is what made the
  camera chrome read as too small.

  Stroke-only, drawn black and tinted at the call site.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M9,14L4,9L9,4"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M4,9H14.5A5.5,5.5 0 0 1 20,14.5A5.5,5.5 0 0 1 14.5,20H11"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
