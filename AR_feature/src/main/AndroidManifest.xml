<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Play treats the CAMERA permission as an implied hard camera requirement, which would
         undo the required=false below. Declared explicitly to keep the install surface open. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- required=false so the app installs on non-AR devices; the Picture Measure path still
         works there and the Measure tab shows an explicit unsupported screen. Flipping this to
         true would make Play Store filter the listing out of search results on those
         devices, costing impressions and not just installs. -->
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="false" />

    <application>

        <!-- "optional": ARCore ships as a separate APK (Google Play Services for AR).
             The app gates the feature itself via ArCoreApk. -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />

        <!-- Needed for the "Chụp ảnh" (take photo) option when registering a custom reference
             object: TakePicture writes to a file the camera app must be granted access to, and
             a plain file:// Uri is blocked by FileUriExposedException on API 24+. Module-owned
             subclass + authority so a host app's own FileProvider never manifest-merger-conflicts
             with this one. -->
        <provider
            android:name="vn.apero.armeasure.photo.data.ArMeasurePhotoFileProvider"
            android:authorities="${applicationId}.armeasure.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
